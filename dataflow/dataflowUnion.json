{
	"name": "dataflowUnion",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText13",
						"type": "DatasetReference"
					},
					"name": "mumbai"
				},
				{
					"dataset": {
						"referenceName": "DelimitedText14",
						"type": "DatasetReference"
					},
					"name": "Delhi"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText15",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Month as string,",
				"          Location as string,",
				"          Sales as string,",
				"          Profit as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> mumbai",
				"source(output(",
				"          Month as string,",
				"          Location as string,",
				"          Sales as string,",
				"          Profit as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Delhi",
				"mumbai, Delhi union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Entity as string,",
				"          {Profit center} as string,",
				"          {Material Code} as string,",
				"          {Trading Partner} as string,",
				"          {Transaction Currency} as string,",
				"          VV110_Q1 as string,",
				"          VV110_Q2 as string,",
				"          VV110_Q3 as string,",
				"          KWSVME_S3 as string,",
				"          { VV200 } as string,",
				"          VV830 as string,",
				"          VV831 as string,",
				"          VV832 as string,",
				"          VV834 as string,",
				"          VV847 as string,",
				"          VRPRS as string,",
				"          VV852 as string,",
				"          { VV853 } as string,",
				"          VV420_R1 as string,",
				"          VV420_R2 as string,",
				"          VV420_R3 as string",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}